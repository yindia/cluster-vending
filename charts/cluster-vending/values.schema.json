{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "cluster-vending chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "global": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "aws": {
      "type": "object",
      "properties": {
        "managementRoleArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:iam::[0-9]{12}:role/.+)?$",
          "description": "The IAM role the Crossplane AWS providers run as; required with the controller"
        },
        "serverRoleArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:iam::[0-9]{12}:role/.+)?$",
          "description": "The API server's own IRSA role"
        },
        "region": {
          "type": "string"
        },
        "sourceRoleArn": {
          "type": "string",
          "pattern": "^(arn:aws[a-z-]*:iam::[0-9]{12}:role/.+)?$"
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "description": "The shared settings file (/etc/cluster-vending/platform.yaml): flag names plus auth, naas and nodeGroups",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "none",
                "optional",
                "required"
              ]
            }
          }
        },
        "naas": {
          "type": "object"
        },
        "nodeGroups": {
          "type": "object"
        }
      }
    },
    "log": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "rbac": {
      "type": "object",
      "properties": {
        "userRoles": {
          "type": "boolean",
          "description": "The helper ClusterRoles for people"
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy this workload"
        },
        "extraEnv": {
          "type": "array"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Default: <fullname>-<component>"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "startupProbe": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "controller": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy this workload"
        },
        "extraEnv": {
          "type": "array"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Default: <fullname>-<component>"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "leaderElect": {
          "type": "boolean",
          "description": "Required when replicas > 1"
        },
        "installProviders": {
          "type": "boolean"
        },
        "installCatalog": {
          "type": "boolean"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "topologySpreadConstraints": {
          "type": "array"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "live": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy this workload"
        },
        "extraEnv": {
          "type": "array"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "ui": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Deploy this workload"
        },
        "extraEnv": {
          "type": "array"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Default: <fullname>-<component>"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "livenessProbe": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repository"
          ]
        },
        "apiBaseUrl": {
          "type": "string",
          "description": "Default: the server Service of this release",
          "pattern": "^(https?://.+)?$"
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "pattern": "^(https?://[^/]+)?$"
            },
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "hosts": {
              "type": "array"
            },
            "tls": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "live": {
          "type": "boolean",
          "description": "Restrict the live reader to the API server (PROP-02 7.4)"
        },
        "server": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "from": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "ui": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "from": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "controllerMetrics": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
