# Server-side upstream for the same-origin Connect bridge. Never NEXT_PUBLIC.
CV_API_BASE_URL=http://127.0.0.1:8080
# Login off: the RPC route accepts an Origin naming the request's Host. Optional:
# CV_PUBLIC_ORIGIN=https://console.example.com   # also accept this origin
# CV_TRUST_FORWARDED_HEADERS=true                 # use X-Forwarded-Host/-Proto (only behind a proxy that sets them)
# Development mode follows auth in hack/config.local.yaml; this flag is used
# by production, which requires an explicit authentication choice.
AUTH_ENABLED=false
# For local sign-in, use the private settings generated by hack/keycloak.sh.
# For production, enable auth and provide these SERVER-ONLY values via secrets:
# AUTH_ENABLED=true
# AUTH_URL=https://console.example.com
# KEYCLOAK_ISSUER=https://identity.example.com/realms/platform
# KEYCLOAK_CLIENT_ID=cv-ui
# KEYCLOAK_CLIENT_SECRET=
# AUTH_SECRET=  # at least 32 random bytes; same value across UI replicas
