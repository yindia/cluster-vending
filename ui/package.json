{
  "name": "cluster-vending-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test src/lib/api/*.test.ts src/lib/auth/*.test.ts src/lib/workflows/*.test.ts && node --test scripts/dev-config.test.mjs",
    "codegen": "cd .. && buf generate --template ui/buf.gen.yaml",
    "doctor": "astryx doctor --built .",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.16",
    "@astryxdesign/theme-neutral": "^0.7.16",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@lezer/highlight": "^1.2.5",
    "@stylexjs/stylex": "^0.19.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^13.0.1",
    "jose": "^6.1.3",
    "next": "16.4.6",
    "openid-client": "^6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.16",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0 <27"
  }
}
